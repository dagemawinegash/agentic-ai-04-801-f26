# Copy this file to .env and put in your own credentials.
# .env is gitignored. It stays on your machine. Always. (Week 0, Leak Drill.)

# OpenRouter: your personal key is issued by the course and arrives by e-mail.
# Do not create an account of your own. Paste the key after the equals sign.
OPENROUTER_API_KEY=sk-or-v1-YOUR-KEY

# iSDAsoil (Week 3): free registration at https://isda-africa.com/api/registration
ISDA_USERNAME=your-email
ISDA_PASSWORD=your-password
